#!/usr/bin/env bash
set -euo pipefail

INPUT_FILE="$(mktemp)"
OUTPUT_FILE="$(mktemp)"
trap 'rm -f "$INPUT_FILE" "$OUTPUT_FILE"' EXIT

cat >"$INPUT_FILE"

if [[ $# -gt 0 && -z "${TMUX_SMART_COPY_TARGET:-}" ]]; then
  TMUX_SMART_COPY_TARGET="$1"
fi

SOCKET_PATH=""
PANE_WIDTH=""
SELECTION_START_X=""
SELECTION_START_Y=""
SELECTION_END_X=""
SELECTION_END_Y=""
HISTORY_SIZE=""

TMUX_TARGET_ARGS=()
if [[ -n "${TMUX_SMART_COPY_TARGET:-}" ]]; then
  TMUX_TARGET_ARGS=(-t "$TMUX_SMART_COPY_TARGET")
fi

if metadata="$(tmux display-message "${TMUX_TARGET_ARGS[@]}" -p '#{socket_path} #{pane_width} #{selection_start_x} #{selection_start_y} #{selection_end_x} #{selection_end_y} #{history_size}' 2>/dev/null)"; then
  read -r SOCKET_PATH PANE_WIDTH SELECTION_START_X SELECTION_START_Y SELECTION_END_X SELECTION_END_Y HISTORY_SIZE <<EOF_META
$metadata
EOF_META
fi

if command -v python3 >/dev/null 2>&1; then
  SOCKET_PATH="$SOCKET_PATH" \
  TMUX_SMART_COPY_TARGET="${TMUX_SMART_COPY_TARGET:-}" \
  PANE_WIDTH="$PANE_WIDTH" \
  SELECTION_START_X="$SELECTION_START_X" \
  SELECTION_START_Y="$SELECTION_START_Y" \
  SELECTION_END_X="$SELECTION_END_X" \
  SELECTION_END_Y="$SELECTION_END_Y" \
  HISTORY_SIZE="$HISTORY_SIZE" \
  python3 - "$INPUT_FILE" "$OUTPUT_FILE" <<'PY'
import os
import subprocess
import sys
from pathlib import Path

input_path = Path(sys.argv[1])
output_path = Path(sys.argv[2])

text = input_path.read_bytes().decode("utf-8", "surrogateescape").replace("\r\n", "\n")


def as_int(name):
    try:
        value = os.environ.get(name, "")
        return int(value) if value != "" else None
    except ValueError:
        return None


socket_path = os.environ.get("SOCKET_PATH", "")
target = os.environ.get("TMUX_SMART_COPY_TARGET", "")
pane_width = as_int("PANE_WIDTH")
start_x = as_int("SELECTION_START_X")
start_y = as_int("SELECTION_START_Y")
end_x = as_int("SELECTION_END_X")
end_y = as_int("SELECTION_END_Y")
history_size = as_int("HISTORY_SIZE")

# If tmux selection metadata is unavailable, preserve copy semantics exactly.
if not pane_width or start_x is None or start_y is None or end_x is None or end_y is None or history_size is None or "\n" not in text:
    output_path.write_bytes(text.encode("utf-8", "surrogateescape"))
    sys.exit(0)

# Standard selections are emitted top-to-bottom. Use tmux's own wrap flags
# below instead of guessing from row width.
top_y = min(start_y, end_y)

# selection_*_y is an absolute line number that includes scrollback history,
# while capture-pane -S/-E is relative to the current screen with history rows
# addressed as negative offsets.  Normalize before asking tmux about row wraps;
# otherwise mouse copy from history can query empty future rows and flatten hard
# newlines.
top_capture_y = top_y - history_size
bottom_capture_y = max(start_y, end_y) - history_size


def capture_joined(start_row, end_row):
    cmd = ["tmux"]
    if socket_path:
        cmd += ["-S", socket_path]
    cmd += ["capture-pane", "-p", "-M", "-J"]
    if target:
        cmd += ["-t", target]
    cmd += ["-S", str(start_row), "-E", str(end_row)]
    captured = subprocess.run(cmd, check=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode(
        "utf-8", "surrogateescape"
    )
    return captured[:-1] if captured.endswith("\n") else captured


def find_line_end_row(start_row, copied_line):
    # tmux may already join terminal soft wraps before piping the copied text.
    # Match the copied logical line back to one or more screen rows so a hard
    # newline after an already-joined wrapped line is not mistaken for the
    # first soft-wrap boundary inside that line.
    for end_row in range(start_row, bottom_capture_y + 1):
        try:
            if capture_joined(start_row, end_row) == copied_line:
                return end_row
        except Exception:
            return None
    return None

lines = text.split("\n")
out = []
line_count = len(lines)
row_cursor = top_capture_y
selection_mapping_known = True

for index, line in enumerate(lines):
    out.append(line)
    if index == line_count - 1:
        break

    if selection_mapping_known:
        row = find_line_end_row(row_cursor, line)
        if row is None:
            selection_mapping_known = False
        else:
            row_cursor = row + 1

    if not selection_mapping_known:
        out.append("\n")
        continue

    # Ask tmux whether this screen-row boundary is a real newline or a soft
    # wrap.  capture-pane -J uses tmux's own wrap flags, so full-width hard
    # lines stay line-oriented while true soft wraps are joined.
    try:
        tmux_says_soft_wrap = selection_mapping_known and "\n" not in capture_joined(row, row + 1)
    except Exception:
        # If tmux cannot answer, preserve bytes rather than guessing and
        # potentially deleting a hard newline.
        tmux_says_soft_wrap = False

    if tmux_says_soft_wrap:
        # A soft wrap is a screen boundary, not copied content.  Do not inject
        # a space here; long URLs, paths, hashes, and CJK text must keep their
        # original bytes across the wrap boundary.
        continue
    else:
        out.append("\n")

normalized = "".join(out)
output_path.write_bytes(normalized.encode("utf-8", "surrogateescape"))
PY
else
  # Without Python, keep tmux's original copy bytes rather than flattening
  # line-oriented selections and losing structure.
  cp "$INPUT_FILE" "$OUTPUT_FILE"
fi

# Let tmux own the paste buffer and terminal clipboard through set-clipboard/OSC 52.
# This keeps the copy path OS-agnostic instead of shelling out to pbcopy/wl-copy/xclip.
tmux load-buffer -w "$OUTPUT_FILE" 2>/dev/null || tmux load-buffer "$OUTPUT_FILE"
